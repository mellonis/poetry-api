# Validated at startup — the server refuses to boot without them.
CONNECTION_STRING=mysql://user:password@localhost:3306/poetry
JWT_SECRET=
# Seconds. 900 = 15 min access token, 2592000 = 30 days refresh token.
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# Seconds. Verification key lifetimes; see mellonis/poetry docs/auth.md for the
# rationale behind the two very different values.
ACTIVATION_KEY_TTL=86400
RESET_KEY_TTL=3600

# Required in production (NODE_ENV=production) only; in dev, notifications are
# logged to the console instead of sent.
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
# Display name and address for the From header. SMTP_FROM_ADDRESS deliberately
# has no fallback to SMTP_LOGIN — that would leak the credential into headers.
SMTP_FROM_NAME="Система оповещений "
SMTP_FROM_ADDRESS=notifier@mellonis.ru

# Comma-separated whitelist of client origins. Used for CORS and for building
# the links that go out in emails.
ALLOWED_ORIGINS=

WEBAUTHN_RP_ID=localhost                # use `poetry.ddev.site` for DDEV-based local dev (passkeys require RP ID to match the page origin)

# Receives notifications on votes, registrations, account deletions and comment
# reports. Optional — unset means those emails are not sent.
ADMIN_NOTIFY_EMAIL=

# auth_user.id of the human site owner. Comments by this user get isAuthor=true,
# rendered as the «Автор сайта» badge. Deliberately decoupled from the "root
# admin is id=1" convention — the owner may post under a different account.
SITE_AUTHOR_USER_ID=1

# Search. Without MEILI_MASTER_KEY search is disabled: sync calls become no-ops
# and GET /search returns 503.
MEILI_URL=http://poetry-meilisearch:7700
MEILI_MASTER_KEY=

# HMAC key for the actorFingerprint() log helper. In prod it is written by the
# VPS rotation script; in dev any non-empty string works.
LOG_HMAC_KEY_CURRENT=dev-placeholder-do-not-use-in-prod-this-is-only-for-local-tests
# Prior key during a rotation overlap. Not read by the emitters — kept in env so
# log analysts can still resolve fingerprints issued under the old key.
#LOG_HMAC_KEY_PREVIOUS=

# Gates POST /setup/admin for the first-run wizard. When set and no active admin
# exists, the wizard collects this secret from the operator (separate from the
# chosen admin password) and forwards it as a one-shot authorization. Unset in
# normal operation; set it on first deploy and unset it once the admin exists.
INITIAL_ADMIN_PASSWORD=

# Cache revalidation. poetry-api is the single writer of content, so it calls the
# two site caches' clear webhooks after every content write (things, sections,
# author page). Both optional; the secret is required when either URL is set and
# must equal REVALIDATION_SECRET in poetry-nextjs and poetry-old2. In-network URLs
# on the prod docker network: http://poetry:3000/api/revalidate and
# http://poetry-old2/revalidate.php.
REVALIDATION_SECRET=
NEXTJS_REVALIDATE_URL=
WWW_REVALIDATE_URL=
